{
  "name": "waterpaint",
  "version": "1.0.0",
  "private": true,
  "description": "A quiet studio for living watercolor",
  "author": "WaterPaint",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:electron": "npm run build && node scripts/electron-test.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "spectral.js": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.60",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "studio.waterpaint.desktop",
    "productName": "WaterPaint",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "extraResources": [{ "from": "resources/icon.png", "to": "icon.png" }],
    "win": {
      "target": "nsis",
      "artifactName": "WaterPaint-${version}-Setup.${ext}",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "fileAssociations": [
      {
        "ext": "waterpaint",
        "name": "WaterPaint artwork",
        "role": "Editor"
      }
    ]
  }
}
